# Copy to .env and fill in. Only FORMS_ADMIN_PASSWORD is required in production.

# The password for the portal (the builder and responses). Required in production;
# with it unset in development, the portal is open on your machine.
FORMS_ADMIN_PASSWORD=

# The address people reach this app at. Used in links inside emails and Slack posts.
FORMS_PUBLIC_URL=http://localhost:3000

# Where the database and uploaded files live. Mount a volume here in production.
FORMS_DATA_DIR=./data

# Optional: the name in the top bar and the browser tab.
# FORMS_BRAND_NAME=Forms

# Optional: serve public forms at the root of a second domain (forms.example.com/<slug>).
# FORMS_PUBLIC_HOST=forms.example.com
# ...and the same host here, set before `npm run build`, so share links use it:
# NEXT_PUBLIC_FORMS_PUBLIC_HOST=forms.example.com

# Optional: email (response alerts and respondent confirmations) over SMTP.
# Works with Resend, Postmark, SendGrid, Amazon SES, Mailgun, or Gmail with an app password.
# FORMS_SMTP_URL=smtps://resend:re_xxx@smtp.resend.com:465
# FORMS_EMAIL_FROM=Forms <forms@example.com>

# Optional: post new responses to Slack. A Slack app's bot token with
# chat:write, channels:read, groups:read, users:read and users:read.email.
# SLACK_BOT_TOKEN=xoxb-...

# Optional: keep uploads in S3-compatible storage (S3, R2, Tigris) instead of the data folder.
# BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=auto
# AWS_ENDPOINT_URL_S3=

# Optional: a fixed signing secret (32+ characters). Without it, one is made on first boot
# and kept in the data folder.
# FORMS_SECRET=

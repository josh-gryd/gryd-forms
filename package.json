{
  "name": "gryd-forms",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted forms: a builder, public forms, logic, uploads and responses, in one small app.",
  "license": "MIT",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "tsx server.ts --dev",
    "build": "next build",
    "start": "NODE_ENV=production tsx server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "TZ=UTC tsx --test 'engine/**/*.test.ts' 'app/**/*.test.ts' 'lib/**/*.test.ts'",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1139.0",
    "@aws-sdk/s3-request-presigner": "3.1139.0",
    "@dnd-kit/core": "6.3.1",
    "better-sqlite3": "12.9.0",
    "express": "5.2.1",
    "next": "16.4.2",
    "nodemailer": "6.10.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "5.0.6",
    "@types/node": "22.15.21",
    "@types/nodemailer": "6.4.17",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.5.0",
    "axe-core": "^4.10.3",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.19",
    "typescript": "5.9.3"
  }
}
